# Environment Variables - Example
# Copy this to .env.local and update values for production

# Security Settings
NEXT_PUBLIC_MAX_QUESTION_LENGTH=5000
NEXT_PUBLIC_MAX_QUESTIONS_BULK=1000
NEXT_PUBLIC_MAX_QUESTIONS_TOTAL=10000
NEXT_PUBLIC_MAX_IMPORT_SIZE=1048576

# Feature Flags
NEXT_PUBLIC_ENABLE_EXPORT=true
NEXT_PUBLIC_ENABLE_IMPORT=true
NEXT_PUBLIC_ENABLE_BULK_ADD=true

# Logging
LOG_LEVEL=info
# production | development
NODE_ENV=production
